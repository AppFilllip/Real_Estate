  leadId     String   @map("lead_id") @db.ObjectId
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status        EnrolmentStatus @default(ACTIVE)
  currentStepId String?         @map("current_step_id") @db.ObjectId
  currentStep   SequenceStep?   @relation(fields: [currentStepId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextRunAt     DateTime?       @map("next_run_at")
  exitReason    String?         @map("exit_reason")
  completedAt   DateTime?       @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sequenceId, status])
  @@index([leadId])
  @@index([companyId, status, nextRunAt])
  @@map("enrolments")
}

model Broadcast {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaignId String?   @map("campaign_id") @db.ObjectId
