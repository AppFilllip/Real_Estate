/// §12.3 — raised when two brokers, or a broker and a direct lead, claim the
/// same phone number inside the protection window.
model LeadDispute {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @map("company_id") @db.ObjectId
  leadId    String @map("lead_id") @db.ObjectId
