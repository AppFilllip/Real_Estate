  status      BroadcastStatus @default(DRAFT)
  /// Same filter shape as the leads and customers lists.
  segmentJson Json?           @map("segment_json")
  audienceCount Int?          @map("audience_count")
  scheduledAt DateTime?       @map("scheduled_at")
  sentAt      DateTime?       @map("sent_at")

  sentCount      Int @default(0) @map("sent_count")
  deliveredCount Int @default(0) @map("delivered_count")
  readCount      Int @default(0) @map("read_count")
  repliedCount   Int @default(0) @map("replied_count")
  optOutCount    Int @default(0) @map("opt_out_count")
  failedCount    Int @default(0) @map("failed_count")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@map("broadcasts")
}

// ===========================================================================
// 10. COMMUNICATION CENTRE (§15)
// ===========================================================================

model Conversation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadId    String? @map("lead_id") @db.ObjectId
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerId String?   @map("customer_id") @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  channel     Channel
  status      ConversationStatus @default(OPEN)
  contactValue String            @map("contact_value")

  assigneeId String? @map("assignee_id") @db.ObjectId
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  lastMessageAt      DateTime? @map("last_message_at")
  lastInboundAt      DateTime? @map("last_inbound_at")
  /// §15 — the 24-hour WhatsApp session window. Outside it, only templates send.
  sessionExpiresAt   DateTime? @map("session_expires_at")
  unreadCount        Int       @default(0) @map("unread_count")
  /// Highlighted at 10 min unanswered, TL notified at 30.
  firstResponseDueAt DateTime? @map("first_response_due_at")
  closedAt           DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@index([companyId, status, lastMessageAt])
  @@index([assigneeId, status])
  @@index([companyId, contactValue])
  @@map("conversations")
}

model Message {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String       @map("company_id") @db.ObjectId
  conversationId String       @map("conversation_id") @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  direction MessageDirection
  status    MessageStatus    @default(QUEUED)
  body      String?
  attachmentsJson Json?      @map("attachments_json")
  templateId String?         @map("template_id") @db.ObjectId
  template   Template?       @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Yellow background in the thread, never sent to the customer (§15).
  isInternalNote Boolean      @default(false) @map("is_internal_note")

  /// Provider message id — the idempotency key for inbound webhooks (§23).
  providerMessageId String?   @map("provider_message_id")
  failureReason     String?   @map("failure_reason")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")

  senderType ActorType @default(USER) @map("sender_type")
  senderId   String?   @map("sender_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, providerMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

