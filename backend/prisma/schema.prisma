  recordingEnabled  Boolean   @default(true) @map("recording_enabled")
  announcementEnabled Boolean @default(true) @map("announcement_enabled")
  whisperEnabled    Boolean   @default(true) @map("whisper_enabled")
  hoursProfileJson  Json?     @map("hours_profile_json")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  versions IvrFlowVersion[]
  numbers  PhoneNumber[]

  @@unique([companyId, name])
  @@map("ivr_flows")
