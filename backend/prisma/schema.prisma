// ===========================================================================
// 1. TENANCY & IDENTITY (§3, §17)
// ===========================================================================

/// A1: GBG Real Estate and Lumotis Realty run as two Companies in one instance.
model Company {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  legalName      String?   @map("legal_name")
  shortCode      String    @unique @map("short_code")
  logoUrl        String?   @map("logo_url")
  letterheadUrl  String?   @map("letterhead_url")
  gstin          String?
  pan            String?
  reraPromoterNo String?   @map("rera_promoter_no")
  addressJson    Json?     @map("address_json")
  /// Name, designation and signature image per signatory — merged into documents.
  signatoriesJson Json?    @map("signatories_json")
  financialYearStartMonth Int @default(4) @map("financial_year_start_month")
  workingHoursJson Json?   @map("working_hours_json")
  holidaysJson   Json?     @map("holidays_json")
  settingsJson   Json?     @map("settings_json")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users             User[]
  teams             Team[]
  roles             Role[]
  projects          Project[]
  leads             Lead[]
  leadSources       LeadSource[]
  campaigns         Campaign[]
  customers         Customer[]
  bookings          Booking[]
  brokers           Broker[]
  drivers           Driver[]
  offers            Offer[]
  paymentPlanTemplates PaymentPlanTemplate[]
  tickets           Ticket[]
  templates         Template[]
  documentTemplates DocumentTemplate[]
  sequences         Sequence[]
  broadcasts        Broadcast[]
  conversations     Conversation[]
  phoneNumbers      PhoneNumber[]
  ivrFlows          IvrFlow[]
  approvalRequests  ApprovalRequest[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  customFieldDefs   CustomFieldDef[]
  notifications     Notification[]

  @@map("companies")
}

/// Permission matrix from §3.2 lives in Role.permissionsJson; custom roles clone
/// a base RoleCode and override.
model Role {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String   @map("company_id") @db.ObjectId
  company         Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code            RoleCode
  name            String
  isSystem        Boolean  @default(false) @map("is_system")
  /// { "leads": ["C","R","U"], "scope": "team", "fields": { "leadPhone": false } }
  permissionsJson Json     @map("permissions_json")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users       User[]
  permissions Permission[]

  @@unique([companyId, name])
  @@index([companyId, code])
  @@map("roles")
}

/// Normalised permission rows. Kept alongside Role.permissionsJson so the matrix
/// editor can query and diff individual grants.
model Permission {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  roleId   String  @map("role_id") @db.ObjectId
  role     Role    @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource String
  action   String
  scope    String  @default("all")
  allowed  Boolean @default(true)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String    @map("company_id") @db.ObjectId
  company  Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name     String
  email    String
  phone    String
  passwordHash String? @map("password_hash")
  avatarUrl String?   @map("avatar_url")
  status   UserStatus @default(INVITED)

  roleId String @map("role_id") @db.ObjectId
  role   Role   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  teamId String? @map("team_id") @db.ObjectId
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  managerId String? @map("manager_id") @db.ObjectId
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports   User[]  @relation("UserManager")

  /// §17.2 — the IVR line this user dials out on.
  outboundLineId String?      @map("outbound_line_id") @db.ObjectId
  outboundLine   PhoneNumber? @relation("UserOutboundLine", fields: [outboundLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  dailyLeadCap  Int?      @map("daily_lead_cap")
  shiftStart    String?   @map("shift_start")
  shiftEnd      String?   @map("shift_end")
  onLeaveUntil  DateTime? @map("on_leave_until")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  lastLoginAt   DateTime? @map("last_login_at")
  /// Monthly targets: { "leads": 120, "visits": 30, "bookings": 5, "value": "50000000" }
  targetsJson   Json?     @map("targets_json")
  preferencesJson Json?   @map("preferences_json")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  teamsLed             Team[]              @relation("TeamLead")
  projectMemberships   ProjectMember[]
  ownedLeads           Lead[]              @relation("LeadOwner")
  assignedTasks        Task[]              @relation("TaskAssignee")
  notes                Note[]              @relation("NoteAuthor")
  siteVisits           SiteVisit[]         @relation("VisitExec")
  holds                Hold[]              @relation("HoldUser")
  unitStatusChanges    UnitStatusHistory[] @relation("UnitStatusActor")
  costSheets           CostSheet[]         @relation("CostSheetPreparedBy")
  tokensReceived       Token[]             @relation("TokenReceivedBy")
  bookingsAsExec       Booking[]           @relation("BookingExec")
  approvalsRequested   ApprovalRequest[]   @relation("ApprovalRequester")
  approvalsToDecide    ApprovalRequest[]   @relation("ApprovalApprover")
  receiptsRecorded     Receipt[]           @relation("ReceiptReceivedBy")
  assignedTickets      Ticket[]            @relation("TicketAssignee")
  conversations        Conversation[]      @relation("ConversationAssignee")
  calls                Call[]              @relation("CallAgent")
  callbacks            Callback[]          @relation("CallbackAssignee")
  notifications        Notification[]
  notificationPreferences NotificationPreference[]
  sessions             Session[]

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([companyId, teamId])
  @@map("users")
}

/// §17.3 — hierarchical: Sales › Team A.
model Session {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @map("user_id") @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  tokenHash String @unique @map("token_hash")
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model Team {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String

  parentId String? @map("parent_id") @db.ObjectId
  parent   Team?   @relation("TeamTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Team[]  @relation("TeamTree")

  leadUserId String? @map("lead_user_id") @db.ObjectId
  leadUser   User?   @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  targetsJson Json? @map("targets_json")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members User[] @relation("TeamMembers")

  @@unique([companyId, name])
  @@map("teams")
}

// ===========================================================================
// 2. PROJECTS (§6)
// ===========================================================================

model Project {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name          String
  /// 2–6 chars, unique per company, used in unit codes (GV2-A-014).
  shortCode     String        @map("short_code")
  ownershipType OwnershipType @map("ownership_type")
  /// A2: for PARTNER projects the developer is another builder.
  developerName String?       @map("developer_name")
  type          ProjectType
  status        ProjectStatus @default(DRAFT)
  statusReason  String?       @map("status_reason")
  description   String?
  coverImageUrl String?       @map("cover_image_url")
  galleryJson   Json?         @map("gallery_json")

  addressLine String? @map("address_line")
  locality    String?
  city        String  @default("Jaipur")
  state       String  @default("Rajasthan")
  pincode     String?
  latitude    Float?
  longitude   Float?
  landmarksJson Json?  @map("landmarks_json")
  distancesJson Json?  @map("distances_json")

  reraNumber        String?   @map("rera_number")
  reraValidTill     DateTime? @map("rera_valid_till")
  approvalAuthority String?   @map("approval_authority")
  approvalNumber    String?   @map("approval_number")
  approvalDate      DateTime? @map("approval_date")
  landArea          Float?  @map("land_area")
  landAreaUnit      String?   @map("land_area_unit")
  khasraNumbersJson Json?     @map("khasra_numbers_json")
  possessionDate    DateTime? @map("possession_date")
  launchDate        DateTime? @map("launch_date")

  hierarchyTemplate HierarchyTemplate? @map("hierarchy_template")

  /// §6.3 Team & Settings — per-project overrides of the global defaults.
  unitCodeFormat    String  @default("{PROJ}-{BLOCK}-{NUM:3}") @map("unit_code_format")
  holdDurationHours Int     @default(48) @map("hold_duration_hours")
  maxHoldsPerExec   Int     @default(3) @map("max_holds_per_exec")
  tokenValidityDays Int     @default(7) @map("token_validity_days")
  minTokenAmount    BigInt? @map("min_token_amount")
  visibleToBrokers  Boolean @default(false) @map("visible_to_brokers")
  showPricesToBrokers Boolean @default(false) @map("show_prices_to_brokers")
  defaultBrokeragePct Float? @map("default_brokerage_pct")
  leadAssignmentRule  String?  @map("lead_assignment_rule")
  visitSlotConfigJson Json?    @map("visit_slot_config_json")
  /// §9.6 field check-in geofence, metres.
  geofenceRadiusM   Int      @default(500) @map("geofence_radius_m")
  amenitiesJson     Json?    @map("amenities_json")
  bankTieUpsJson    Json?    @map("bank_tie_ups_json")
  brochureUrl       String?  @map("brochure_url")
  layoutPlanUrl     String?  @map("layout_plan_url")

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  blocks        Block[]
  units         Unit[]
  rateCards     RateCard[]
  plcs          Plc[]
  members       ProjectMember[]
  milestones    Milestone[]
  leads         Lead[]
  siteVisits    SiteVisit[]
  bookings      Booking[]
  costSheets    CostSheet[]
  holds         Hold[]
  tokens        Token[]
  brokerProjects BrokerProject[]
  documentTemplates DocumentTemplate[]
  campaigns     Campaign[]
  phoneNumbers  PhoneNumber[]

  @@unique([companyId, shortCode])
  @@index([companyId, status])
  @@index([companyId, city])
  @@map("projects")
}

/// Sales team assigned to a project (§6.2 step 6).
model ProjectMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String  @map("user_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inRoundRobin Boolean @default(true) @map("in_round_robin")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Block A/B for plots, Tower T1 for apartments.
model Block {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  code      String
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  floors Floor[]
  units  Unit[]

  @@unique([projectId, name])
  @@index([companyId])
  @@map("blocks")
}

/// Apartments only: Project → Tower → Floor → Flat.
model Floor {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  blockId   String  @map("block_id") @db.ObjectId
  block     Block   @relation(fields: [blockId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  number    Int
  name      String?

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  units Unit[]

  @@unique([blockId, number])
  @@index([companyId])
  @@map("floors")
}

// ===========================================================================
// 3. INVENTORY (§7)
// ===========================================================================

model Unit {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blockId   String  @map("block_id") @db.ObjectId
  block     Block   @relation(fields: [blockId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  floorId   String? @map("floor_id") @db.ObjectId
  floor     Floor?  @relation(fields: [floorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// GV2-A-014. Unique per company — see partial-index migration for the
  /// soft-delete-aware constraint.
  unitCode String @map("unit_code")
  number   String

  area        Float
  areaUnit    String   @default("SQ_YD") @map("area_unit")
  lengthFt    Float? @map("length_ft")
  widthFt     Float? @map("width_ft")
  facing      Facing?
  roadWidthFt Int?     @map("road_width_ft")
  /// ["CORNER","PARK_FACING","ROAD_60FT"] — drives automatic PLC application.
  attributesJson Json? @map("attributes_json")
  carpetArea    Float? @map("carpet_area")
  builtUpArea   Float? @map("built_up_area")
  superArea     Float? @map("super_area")
  parkingCount  Int?     @map("parking_count")
  viewNote      String?  @map("view_note")

  /// §7.6 — written ONLY by the unit status service.
  status           UnitStatus        @default(AVAILABLE)
  notForSaleReason NotForSaleReason? @map("not_for_sale_reason")
  /// Snapshot taken when the unit left AVAILABLE, so a rate card publish cannot
  /// move the price of a blocked or booked unit.
  lockedPriceJson  Json?             @map("locked_price_json")
  lockedRateCardId String?           @map("locked_rate_card_id")
  lockedAt         DateTime?         @map("locked_at")
  /// Set when a cancellation returns the unit to AVAILABLE (§7.6).
  isReReleased     Boolean           @default(false) @map("is_re_released")
  availableSince   DateTime?         @map("available_since")

  /// Optimistic lock — stale writes return 409 (§23).
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  polygon       UnitPolygon?
  statusHistory UnitStatusHistory[]
  holds         Hold[]
  tokens        Token[]
  costSheets    CostSheet[]
  bookings      Booking[]
  shortlistedBy LeadShortlist[]

  @@index([companyId, projectId, status])
  @@index([projectId, blockId, number])
  @@index([status, availableSince])
  @@map("units")
}

/// §7.4 — coordinates normalised 0–1 so the layout image can be replaced with a
/// higher-resolution scan without remapping every plot.
model UnitPolygon {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  unitId    String  @unique @map("unit_id") @db.ObjectId
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// [[x,y],[x,y],…] each 0–1 relative to the layout image.
  pointsJson Json   @map("points_json")
  labelX    Float? @map("label_x")
  labelY    Float? @map("label_y")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("unit_polygons")
}

/// §7.6 — every status transition writes one row. Never deleted.
model UnitStatusHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String     @map("company_id") @db.ObjectId
  unitId    String     @map("unit_id") @db.ObjectId
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromStatus UnitStatus? @map("from_status")
  toStatus   UnitStatus  @map("to_status")
  reason     String?
  /// Null when the transition was made by an expiry job rather than a person.
  changedById String?    @map("changed_by_id") @db.ObjectId
  changedBy   User?      @relation("UnitStatusActor", fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorType   ActorType  @default(USER) @map("actor_type")
  leadId      String?    @map("lead_id") @db.ObjectId
  bookingId   String?    @map("booking_id") @db.ObjectId
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([unitId, createdAt])
  @@index([companyId])
  @@map("unit_status_history")
}

model RateCard {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  version       Int
  status        RateCardStatus @default(DRAFT)
  effectiveFrom DateTime?      @map("effective_from")
  pricingBasis  PricingBasis   @map("pricing_basis")
  baseRate      BigInt         @map("base_rate")
  /// Rajasthan defaults: 6% male, 5% female (§6.2 step 5).
  stampDutyMalePct   Float @default(6) @map("stamp_duty_male_pct")
  stampDutyFemalePct Float @default(5) @map("stamp_duty_female_pct")
  registrationPct    Float @default(1) @map("registration_pct")

  publishedAt   DateTime? @map("published_at")
  publishedById String?   @map("published_by_id")
  createdById   String?   @map("created_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  charges    RateCardCharge[]
  costSheets CostSheet[]

  @@unique([projectId, version])
  @@index([companyId, status])
  @@map("rate_cards")
}

model RateCardCharge {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  rateCardId String      @map("rate_card_id") @db.ObjectId
  rateCard   RateCard    @relation(fields: [rateCardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String
  basis      ChargeBasis
  amount     BigInt
  taxable    Boolean     @default(false)
  gstPct     Float?    @map("gst_pct")
  sortOrder  Int         @default(0) @map("sort_order")

  @@index([rateCardId])
  @@map("rate_card_charges")
}

/// Preferential Location Charge master. Corner 5%, park facing 5%, 60ft road 3%.
model Plc {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  /// Matches a value in Unit.attributesJson so PLCs auto-apply.
  attributeKey String  @map("attribute_key")
  type      PlcType
  value     BigInt
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, attributeKey])
  @@index([companyId])
  @@map("plcs")
}

/// §7.6 — at most ONE active hold per unit. Enforced by a partial unique index,
/// see the partial-index migration. Redis holds the TTL; this row is the record.
model Hold {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId    String  @map("unit_id") @db.ObjectId
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// A hold without a lead is not allowed (§7.6).
  leadId    String  @map("lead_id") @db.ObjectId
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  heldById String @map("held_by_id") @db.ObjectId
  heldBy   User   @relation("HoldUser", fields: [heldById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status         HoldStatus @default(ACTIVE)
  reason         String?
  expiresAt      DateTime   @map("expires_at")
  extensionsUsed Int        @default(0) @map("extensions_used")
  releasedAt     DateTime?  @map("released_at")
  releaseNote    String?    @map("release_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId, status])
  @@index([companyId, status, expiresAt])
  @@index([heldById, status])
  @@map("holds")
}

// ===========================================================================
// 4. LEADS (§8)
// ===========================================================================

model LeadSource {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  group     String?
  /// §8.9 scoring weight: portal 10, referral 20, walk-in 25, IVR 15, broker 15.
  scoreWeight Int    @default(10) @map("score_weight")
  defaultAssignmentRule String? @map("default_assignment_rule")
  active    Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  leads     Lead[]
  campaigns Campaign[]

  @@unique([companyId, name])
  @@map("lead_sources")
}

model Lead {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name      String
  /// Unique per company among non-merged leads — partial index, see migration.
  phone     String
  altPhone  String? @map("alt_phone")
  email     String?
  city      String?
  languagePreference String? @map("language_preference")

  stage       LeadStage   @default(NEW)
  temperature Temperature @default(COLD)
  /// 0–100, recomputed on events (§8.9).
  score       Int         @default(0)
  scoreBreakdownJson Json? @map("score_breakdown_json")

  lostReason      LostReason? @map("lost_reason")
  lostNote        String?     @map("lost_note")
  competitorName  String?     @map("competitor_name")
  reEngageAfter   DateTime?   @map("re_engage_after")

  ownerId String? @map("owner_id") @db.ObjectId
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  projectId String?  @map("project_id") @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  sourceId String?     @map("source_id") @db.ObjectId
  source   LeadSource? @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  campaignId String?   @map("campaign_id") @db.ObjectId
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// §12.3 — broker tagging and the protection window.
  brokerId          String?   @map("broker_id") @db.ObjectId
  broker            Broker?   @relation(fields: [brokerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brokerTaggedAt    DateTime? @map("broker_tagged_at")
  protectionEndsAt  DateTime? @map("protection_ends_at")

  utmJson       Json?     @map("utm_json")
  firstTouchAt  DateTime? @map("first_touch_at")
  /// §17.6 — first response SLA, 5 min for portals and IVR.
  slaDueAt      DateTime? @map("sla_due_at")
  firstResponseAt DateTime? @map("first_response_at")
  slaBreached   Boolean   @default(false) @map("sla_breached")
  lastActivityAt DateTime? @map("last_activity_at")
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  /// §8.7.2 — set when a lead is left without a next step.
  hasNoNextStep Boolean   @default(false) @map("has_no_next_step")
  isStale       Boolean   @default(false) @map("is_stale")

  /// §8.8 — the loser of a merge points at the survivor and stops being unique.
  mergedIntoId String? @map("merged_into_id") @db.ObjectId
  mergedInto   Lead?   @relation("LeadMerge", fields: [mergedIntoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedFrom   Lead[]  @relation("LeadMerge")

  /// DPDP Act consent logging (§25).
  consentText     String?   @map("consent_text")
  consentAt       DateTime? @map("consent_at")
  marketingOptOut Boolean   @default(false) @map("marketing_opt_out")
  dnd             Boolean   @default(false)

  customerId String?   @map("customer_id") @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById String?   @map("created_by_id")
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  requirement   LeadRequirement?
  shortlists    LeadShortlist[]
  tasks         Task[]
  notes         Note[]
  siteVisits    SiteVisit[]
  holds         Hold[]
  costSheets    CostSheet[]
  tokens        Token[]
  bookings      Booking[]
  conversations Conversation[]
  calls         Call[]
  callbacks     Callback[]
  enrolments    Enrolment[]
  disputes      LeadDispute[]

  @@index([companyId, stage])
  @@index([companyId, ownerId, stage])
  @@index([companyId, phone])
  @@index([companyId, nextFollowUpAt])
  @@index([companyId, slaDueAt])
  @@map("leads")
}

model LeadRequirement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  leadId    String  @unique @map("lead_id") @db.ObjectId
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  budgetMin   BigInt?  @map("budget_min")
  budgetMax   BigInt?  @map("budget_max")
  areaMin     Float? @map("area_min")
  areaMax     Float? @map("area_max")
  facingsJson Json?    @map("facings_json")
  attributesJson Json? @map("attributes_json")
  /// Immediate / 1-3 months / 3-6 months / 6+ months — drives scoring.
  timeline    String?
  purpose     String?
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("lead_requirements")
}

/// Units a lead has shortlisted — surfaced in the unit drawer as "interested
/// leads" so two execs do not negotiate the same plot (§7.3).
model LeadShortlist {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @map("company_id") @db.ObjectId
  leadId    String   @map("lead_id") @db.ObjectId
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId    String   @map("unit_id") @db.ObjectId
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([leadId, unitId])
  @@index([companyId])
  @@map("lead_shortlists")
}

/// Polymorphic timeline (decision 6). entityType is one of
/// LEAD | UNIT | BOOKING | CUSTOMER | SITE_VISIT | BROKER | TICKET.
model Activity {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String    @map("company_id") @db.ObjectId
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  type       String
  summary    String
  dataJson   Json?     @map("data_json")
  actorType  ActorType @default(USER) @map("actor_type")
  actorId    String?   @map("actor_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([companyId, createdAt])
  @@map("activities")
}

model Task {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  leadId    String? @map("lead_id") @db.ObjectId
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookingId String? @map("booking_id") @db.ObjectId
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type       TaskType
  status     TaskStatus @default(OPEN)
  title      String?
  note       String?
  dueAt      DateTime   @map("due_at")
  reminderMinutesBefore Int? @map("reminder_minutes_before")
  snoozedUntil DateTime? @map("snoozed_until")
  completedAt  DateTime? @map("completed_at")

  disposition     DispositionCode?
  dispositionNote String?          @map("disposition_note")

  assigneeId String @map("assignee_id") @db.ObjectId
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([companyId, assigneeId, status, dueAt])
  @@index([leadId])
  @@map("tasks")
}

model Note {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  leadId    String? @map("lead_id") @db.ObjectId
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookingId String? @map("booking_id") @db.ObjectId
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  body        String
  isInternal  Boolean @default(true) @map("is_internal")
  attachmentsJson Json? @map("attachments_json")
  mentionsJson    Json? @map("mentions_json")

  authorId String @map("author_id") @db.ObjectId
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId, leadId])
  @@map("notes")
}

// ===========================================================================
// 5. SITE VISITS (§9)
// ===========================================================================

/// §9.2 — drivers are a lightweight record (name + phone), not full users.
model Driver {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  phone     String
  vehicleNumber String? @map("vehicle_number")
  active    Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  siteVisits SiteVisit[]

  @@index([companyId, active])
  @@map("drivers")
}

model SiteVisit {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  leadId    String  @map("lead_id") @db.ObjectId
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  execId String @map("exec_id") @db.ObjectId
  exec   User   @relation("VisitExec", fields: [execId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  scheduledAt DateTime    @map("scheduled_at")
  slotMinutes Int         @default(30) @map("slot_minutes")
  type        VisitType   @default(SITE)
  status      VisitStatus @default(SCHEDULED)

  pickupRequired Boolean   @default(false) @map("pickup_required")
  pickupAddress  String?   @map("pickup_address")
  pickupAt       DateTime? @map("pickup_at")
  driverId       String?   @map("driver_id") @db.ObjectId
  driver         Driver?   @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  attendeesCount Int?    @map("attendees_count")
  notes          String?
  /// Units the exec pinned to show (§9.3).
  unitsToShowJson Json?  @map("units_to_show_json")

  confirmedAt DateTime? @map("confirmed_at")
  /// §9.6 — GPS check-in inside the project geofence.
  checkedInAt   DateTime? @map("checked_in_at")
  checkInLat    Float?  @map("check_in_lat")
  checkInLng    Float?  @map("check_in_lng")
  checkInOutsideGeofence Boolean @default(false) @map("check_in_outside_geofence")
  checkInReason String?   @map("check_in_reason")
  checkInPhotoUrl String? @map("check_in_photo_url")

  /// Set when this visit was created by rescheduling an earlier one.
  rescheduledFromId String?    @map("rescheduled_from_id") @db.ObjectId
  rescheduledFrom   SiteVisit? @relation("VisitReschedule", fields: [rescheduledFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rescheduledTo     SiteVisit[] @relation("VisitReschedule")

  brokerId String? @map("broker_id") @db.ObjectId
  broker   Broker? @relation(fields: [brokerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  remindersSentJson Json?   @map("reminders_sent_json")

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  outcome SiteVisitOutcome?

  @@index([companyId, scheduledAt])
  @@index([companyId, execId, status])
  @@index([projectId, scheduledAt])
  @@map("site_visits")
}

model SiteVisitOutcome {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String    @map("company_id") @db.ObjectId
  siteVisitId String    @unique @map("site_visit_id") @db.ObjectId
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  result        VisitResult
  budgetFit     BudgetFit?  @map("budget_fit")
  /// ["PRICE","LOCATION","SIZE","FACING","POSSESSION","LOAN","OTHER"]
  objectionsJson Json?      @map("objections_json")
  preferredUnitsJson Json?  @map("preferred_units_json")
  nextStep      String      @map("next_step")
  nextFollowUpAt DateTime   @map("next_follow_up_at")
  notes         String?
  photosJson    Json?       @map("photos_json")

  submittedById String?  @map("submitted_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("site_visit_outcomes")
}

// ===========================================================================
// 6. QUOTATION, DISCOUNT, TOKEN & BOOKING (§10)
// ===========================================================================

model CostSheet {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadId    String  @map("lead_id") @db.ObjectId
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId    String  @map("unit_id") @db.ObjectId
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateCardId String   @map("rate_card_id") @db.ObjectId
  rateCard   RateCard @relation(fields: [rateCardId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  version       Int    @default(1)
  applicantName String @map("applicant_name")

  baseCost      BigInt  @map("base_cost")
  plcTotal      BigInt  @default(0) @map("plc_total")
  chargesTotal  BigInt  @default(0) @map("charges_total")
  gstAmount     BigInt  @default(0) @map("gst_amount")
  discountAmount BigInt @default(0) @map("discount_amount")
  discountPct   Float? @map("discount_pct")
  agreementValue BigInt @map("agreement_value")
  stampDuty     BigInt  @default(0) @map("stamp_duty")
  registration  BigInt  @default(0) @map("registration")
  totalCost     BigInt  @map("total_cost")
  /// Full line-by-line breakup as rendered on the PDF.
  breakupJson   Json    @map("breakup_json")

  paymentPlanTemplateId String? @map("payment_plan_template_id")
  loanAssumed  Boolean  @default(false) @map("loan_assumed")
  loanPct      Float? @map("loan_pct")
  emiEstimate  BigInt?  @map("emi_estimate")

  validUntil DateTime? @map("valid_until")
  /// Watermarked "Indicative" while a discount approval is pending (§10.1).
  isIndicative Boolean  @default(false) @map("is_indicative")
  /// Set when a newer rate card is published (§6.3).
  isOutdated   Boolean  @default(false) @map("is_outdated")
  pdfUrl       String?  @map("pdf_url")
  shareToken   String?  @unique @map("share_token")
  viewCount    Int      @default(0) @map("view_count")
  firstViewedAt DateTime? @map("first_viewed_at")

  preparedById String @map("prepared_by_id") @db.ObjectId
  preparedBy   User   @relation("CostSheetPreparedBy", fields: [preparedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  offerIds String[] @db.ObjectId @map("offer_ids")
  offers   Offer[]  @relation("CostSheetOffers", fields: [offerIds], references: [id])
  negotiations Negotiation[]

  @@index([companyId, leadId])
  @@index([unitId])
  @@map("cost_sheets")
}

/// §10.2 — the negotiation ladder: what the customer asked, what we offered.
model Negotiation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String    @map("company_id") @db.ObjectId
  costSheetId String    @map("cost_sheet_id") @db.ObjectId
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerAsked BigInt? @map("customer_asked")
  weOffered     BigInt? @map("we_offered")
  notes         String?
  loggedById    String? @map("logged_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([costSheetId, createdAt])
  @@index([companyId])
  @@map("negotiations")
}

/// §17.11 — offer definitions, optionally auto-applied.
model Offer {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  type      OfferType
  value     BigInt?
  freeItem  String?   @map("free_item")
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  projectIdsJson Json? @map("project_ids_json")
  autoApply Boolean  @default(false) @map("auto_apply")
  active    Boolean  @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  costSheetIds String[]    @db.ObjectId @map("cost_sheet_ids")
  costSheets   CostSheet[] @relation("CostSheetOffers", fields: [costSheetIds], references: [id])
  bookingIds   String[]    @db.ObjectId @map("booking_ids")
  bookings     Booking[]   @relation("BookingOffers", fields: [bookingIds], references: [id])

  @@unique([companyId, name])
  @@map("offers")
}

/// §10.3 — one engine for discounts, hold extensions, rate cards, bookings,
/// cancellations, refunds and broker payouts. SLA 4 business hours, then escalate.
model ApprovalRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  /// Polymorphic target: LEAD | UNIT | HOLD | COST_SHEET | BOOKING | REFUND |
  /// RATE_CARD | COMMISSION | DEMAND.
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  requestedAmount BigInt?  @map("requested_amount")
  requestedPct    Float? @map("requested_pct")
  justification   String?
  attachmentsJson Json?    @map("attachments_json")
  /// Margin impact, exec's 30-day discount average, etc. — shown in the modal.
  contextJson     Json?    @map("context_json")

  requestedById String @map("requested_by_id") @db.ObjectId
  requestedBy   User   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approverId String? @map("approver_id") @db.ObjectId
  approver   User?   @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Set when the approver counters with a different amount (§10.3).
  counterAmount BigInt?  @map("counter_amount")
  counterPct    Float? @map("counter_pct")
  decisionNote  String?  @map("decision_note")
  decidedAt     DateTime? @map("decided_at")

  slaDueAt    DateTime? @map("sla_due_at")
  escalatedAt DateTime? @map("escalated_at")
  /// Second approver for dual-approval flows (refund > ₹5,00,000).
  secondApproverId String?   @map("second_approver_id")
  secondDecidedAt  DateTime? @map("second_decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, status, type])
  @@index([approverId, status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

/// §10.4 — token money blocking a unit. Never auto-released on expiry.
model Token {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadId    String  @map("lead_id") @db.ObjectId
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId    String  @map("unit_id") @db.ObjectId
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  receiptNumber String      @map("receipt_number")
  amount        BigInt
  mode          PaymentMode
  transactionRef String?    @map("transaction_ref")
  chequeNumber  String?     @map("cheque_number")
  bankName      String?     @map("bank_name")
  receivedOn    DateTime    @map("received_on")
  proofUrl      String?     @map("proof_url")

  agreedPrice   BigInt      @map("agreed_price")
  validUntil    DateTime    @map("valid_until")
  status        TokenStatus @default(RECEIVED)
  notes         String?
  /// Razorpay link id when the token was collected online.
  paymentLinkId String?     @map("payment_link_id")
  pdfUrl        String?     @map("pdf_url")

  receivedById String? @map("received_by_id") @db.ObjectId
  receivedBy   User?   @relation("TokenReceivedBy", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@unique([companyId, receiptNumber])
  @@index([unitId, status])
  @@index([companyId, status, validUntil])
  @@map("tokens")
}

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId    String  @map("unit_id") @db.ObjectId
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadId    String? @map("lead_id") @db.ObjectId
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tokenId   String? @map("token_id") @db.ObjectId
  token     Token?  @relation(fields: [tokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerId String?   @map("customer_id") @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// BK/GV2/0128
  bookingNumber String        @map("booking_number")
  status        BookingStatus @default(DRAFT)
  bookedOn      DateTime?     @map("booked_on")

  agreementValue BigInt  @map("agreement_value")
  discountAmount BigInt  @default(0) @map("discount_amount")
  /// §22 invariant — snapshot of the cost breakup taken at approval.
  lockedPriceJson Json?  @map("locked_price_json")

  brokerId      String?  @map("broker_id") @db.ObjectId
  broker        Broker?  @relation(fields: [brokerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brokeragePct  Float? @map("brokerage_pct")
  brokerageAmount BigInt? @map("brokerage_amount")

  fundingType FundingType @default(SELF) @map("funding_type")
  bankName    String?     @map("bank_name")
  loanAmount  BigInt?     @map("loan_amount")
  loanStatus  LoanStatus  @default(NOT_APPLIED) @map("loan_status")
  sanctionLetterUrl String? @map("sanction_letter_url")

  nomineeName     String? @map("nominee_name")
  nomineeRelation String? @map("nominee_relation")
  nomineeDob      DateTime? @map("nominee_dob")
  nomineeAddress  String? @map("nominee_address")

  eSignMethod ESignMethod? @map("e_sign_method")
  declarationsAccepted Boolean @default(false) @map("declarations_accepted")

  /// §10.6 status stepper, each with a required document.
  agreementSignedOn DateTime? @map("agreement_signed_on")
  agreementUrl      String?   @map("agreement_url")
  registeredOn      DateTime? @map("registered_on")
  registrationNumber String?  @map("registration_number")
  registryDeedUrl   String?   @map("registry_deed_url")
  possessionOn      DateTime? @map("possession_on")
  possessionLetterUrl String? @map("possession_letter_url")
  sroOffice         String?   @map("sro_office")

  /// A2 — partner projects go to the developer for confirmation (§10.5).
  developerBookingRef String?   @map("developer_booking_ref")
  developerStatus     String?   @map("developer_status")
  developerLetterUrl  String?   @map("developer_letter_url")

  cancelledOn        DateTime? @map("cancelled_on")
  cancelReason       String?   @map("cancel_reason")
  cancelRequestedBy  String?   @map("cancel_requested_by")
  cancellationCharges BigInt?  @map("cancellation_charges")
  refundAmount       BigInt?   @map("refund_amount")

  salesExecId String? @map("sales_exec_id") @db.ObjectId
  salesExec   User?   @relation("BookingExec", fields: [salesExecId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")

  version   Int       @default(0)
  createdById String? @map("created_by_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  applicants  Applicant[]
  paymentPlan PaymentPlan?
  demands     Demand[]
  receipts    Receipt[]
  refunds     Refund[]
  ledger      Ledger[]
  commissions Commission[]
  documents   GeneratedDocument[]
  tickets     Ticket[]
  tasks       Task[]
  notes       Note[]
  offerIds    String[] @db.ObjectId @map("offer_ids")
  offers      Offer[]  @relation("BookingOffers", fields: [offerIds], references: [id])

  @@unique([companyId, bookingNumber])
  @@index([companyId, status])
  @@index([projectId, status])
  @@index([unitId])
  @@map("bookings")
}

model Applicant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  bookingId String  @map("booking_id") @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isPrimary    Boolean @default(false) @map("is_primary")
  relationship String?
  name         String
  fatherOrHusbandName String? @map("father_or_husband_name")
  dob          DateTime?
  /// Drives the stamp duty rate (§6.2 step 5).
  gender       Gender?
  maritalStatus MaritalStatus? @map("marital_status")
  nationality  String?  @default("Indian")
  isNri        Boolean  @default(false) @map("is_nri")

  /// CIPHERTEXT — encrypt in the application, display masked (decision 7).
  panEncrypted     String? @map("pan_encrypted")
  panLast4         String? @map("pan_last4")
  aadhaarEncrypted String? @map("aadhaar_encrypted")
  aadhaarLast4     String? @map("aadhaar_last4")

  phone      String
  email      String?
  occupation String?
  employer   String?
  currentAddress   String? @map("current_address")
  permanentAddress String? @map("permanent_address")
  photoUrl   String? @map("photo_url")

  kycVerified   Boolean   @default(false) @map("kyc_verified")
  kycVerifiedBy String?   @map("kyc_verified_by")
  kycVerifiedAt DateTime? @map("kyc_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents KycDocument[]

  @@index([bookingId])
  @@index([companyId])
  @@map("applicants")
}

model KycDocument {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String     @map("company_id") @db.ObjectId
  applicantId String     @map("applicant_id") @db.ObjectId
  applicant   Applicant  @relation(fields: [applicantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type        KycDocType
  /// Private S3 key — served only through 15-minute signed URLs (§23).
  fileKey     String     @map("file_key")
  fileName    String?    @map("file_name")
  sizeBytes   Int?       @map("size_bytes")
  virusScanned Boolean   @default(false) @map("virus_scanned")
  verified    Boolean    @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([applicantId, type])
  @@index([companyId])
  @@map("kyc_documents")
}

// ===========================================================================
// 7. POST-SALES, PAYMENT PLANS & COLLECTIONS (§11)
// ===========================================================================

model Customer {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name  String
  phone String
  email String?
  /// Unique by PAN or phone (§11.1). CIPHERTEXT.
  panEncrypted String? @map("pan_encrypted")
  panLast4     String? @map("pan_last4")
  addressJson  Json?   @map("address_json")

  portalAccessEnabled Boolean   @default(false) @map("portal_access_enabled")
  portalLastLoginAt   DateTime? @map("portal_last_login_at")
  relationshipManagerId String? @map("relationship_manager_id")

  /// Referral programme (§13.6).
  referredByCustomerId String? @map("referred_by_customer_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  leads         Lead[]
  bookings      Booking[]
  tickets       Ticket[]
  conversations Conversation[]
  calls         Call[]

  @@index([companyId, phone])
  @@map("customers")
}

/// §11.2 — four plan types. Rows live in templateRowsJson so a template can be
/// edited without migrating every plan generated from it.
model PaymentPlanTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @map("company_id") @db.ObjectId
  company   Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String?  @map("project_id") @db.ObjectId
  name      String
  type      PlanType
  /// [{ label, pctOfValue | fixedAmount, dueRule, daysAfterBooking, milestoneId,
  ///    graceDays, interestPctPa }]
  rowsJson  Json     @map("rows_json")
  active    Boolean  @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  paymentPlans PaymentPlan[]

  @@unique([companyId, name])
  @@map("payment_plan_templates")
}

/// The plan actually attached to one booking, frozen at booking time.
model PaymentPlan {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String  @map("company_id") @db.ObjectId
  bookingId  String  @unique @map("booking_id") @db.ObjectId
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateId String? @map("template_id") @db.ObjectId
  template   PaymentPlanTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type     PlanType
  rowsJson Json     @map("rows_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("payment_plans")
}

/// §11.3 — construction milestones defined per project. Marking one complete
/// raises demands across every booking on a construction-linked plan.
model Milestone {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  projectId String  @map("project_id") @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name        String
  sortOrder   Int             @default(0) @map("sort_order")
  plannedDate DateTime?       @map("planned_date")
  actualDate  DateTime?       @map("actual_date")
  status      MilestoneStatus @default(PLANNED)
  photosJson  Json?           @map("photos_json")
  completedById String?       @map("completed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demands Demand[]

  @@unique([projectId, name])
  @@index([companyId])
  @@map("milestones")
}

model Demand {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  bookingId String  @map("booking_id") @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  milestoneId String?    @map("milestone_id") @db.ObjectId
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// DM/GV2/0451
  demandNumber String       @map("demand_number")
  sequenceNo   Int          @map("sequence_no")
  label        String
  pctOfValue   Float?     @map("pct_of_value")
  amount       BigInt
  dueDate      DateTime     @map("due_date")
  graceDays    Int          @default(0) @map("grace_days")
  interestPctPa Float?    @map("interest_pct_pa")
  status       DemandStatus @default(UPCOMING)

  paidAmount     BigInt @default(0) @map("paid_amount")
  interestAccrued BigInt @default(0) @map("interest_accrued")
  interestWaived  BigInt @default(0) @map("interest_waived")

  letterUrl      String?   @map("letter_url")
  lastReminderAt DateTime? @map("last_reminder_at")
  remindersSent  Int       @default(0) @map("reminders_sent")
  waivedReason   String?   @map("waived_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  allocations ReceiptAllocation[]

  @@unique([companyId, demandNumber])
  @@index([bookingId, status])
  @@index([companyId, status, dueDate])
  @@map("demands")
}

model Receipt {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  bookingId String  @map("booking_id") @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// RC/GV2/1023
  receiptNumber String        @map("receipt_number")
  amount        BigInt
  mode          PaymentMode
  status        ReceiptStatus @default(RECORDED)

  transactionRef String?   @map("transaction_ref")
  chequeNumber   String?   @map("cheque_number")
  bankName       String?   @map("bank_name")
  instrumentDate DateTime? @map("instrument_date")
  receivedOn     DateTime  @map("received_on")
  proofUrl       String?   @map("proof_url")
  remarks        String?

  depositedOn DateTime? @map("deposited_on")
  clearedOn   DateTime? @map("cleared_on")
  bouncedOn   DateTime? @map("bounced_on")
  bounceCharge BigInt?  @map("bounce_charge")
  bounceReason String?  @map("bounce_reason")

  /// Amount not yet allocated to a demand — an advance creates unallocated credit.
  unallocatedAmount BigInt @default(0) @map("unallocated_amount")
  pdfUrl String? @map("pdf_url")
  /// Razorpay payment id when collected online.
  paymentGatewayRef String? @map("payment_gateway_ref")

  receivedById String? @map("received_by_id") @db.ObjectId
  receivedBy   User?   @relation("ReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  allocations ReceiptAllocation[]

  @@unique([companyId, receiptNumber])
  @@index([bookingId, status])
  @@index([companyId, status])
  @@map("receipts")
}

/// §11.4 — one receipt can settle several demands (oldest first by default,
/// manually overridable), so allocation is its own table.
model ReceiptAllocation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  receiptId String  @map("receipt_id") @db.ObjectId
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  demandId  String  @map("demand_id") @db.ObjectId
  demand    Demand  @relation(fields: [demandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([receiptId, demandId])
  @@index([demandId])
  @@index([companyId])
  @@map("receipt_allocations")
}

model Refund {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  bookingId String  @map("booking_id") @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  amount        BigInt
  tdsAmount     BigInt?      @map("tds_amount")
  status        RefundStatus @default(REQUESTED)
  mode          PaymentMode?
  expectedDate  DateTime?    @map("expected_date")
  paidOn        DateTime?    @map("paid_on")
  utr           String?
  reason        String?
  requestLetterUrl String?   @map("request_letter_url")

  requestedById String?   @map("requested_by_id") @db.ObjectId
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@index([bookingId])
  @@map("refunds")
}

/// Running statement per booking. Not double-entry accounting (A6) — this is a
/// customer-facing ledger only.
model Ledger {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  bookingId String  @map("booking_id") @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  entryDate   DateTime        @map("entry_date")
  particulars String
  type        LedgerEntryType
  amount      BigInt
  balance     BigInt
  /// DEMAND | RECEIPT | REFUND | INTEREST | BOUNCE_CHARGE | ADJUSTMENT
  sourceType  String?  @map("source_type")
  sourceId    String?  @map("source_id") @db.ObjectId

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId, entryDate])
  @@index([companyId])
