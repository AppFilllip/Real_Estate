  providerFlowRef String? @map("provider_flow_ref")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([flowId, version])
  @@index([companyId])
  @@map("ivr_flow_versions")
}

model Call {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  leadId    String? @map("lead_id") @db.ObjectId
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerId String?   @map("customer_id") @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  phoneNumberId String?      @map("phone_number_id") @db.ObjectId
  phoneNumber   PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  direction CallDirection
  status    CallStatus    @default(INITIATED)
  fromNumber String       @map("from_number")
  toNumber   String       @map("to_number")

  agentId String? @map("agent_id") @db.ObjectId
  agent   User?   @relation("CallAgent", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// "EN › GV2 › Ring group"
  ivrPath      String?   @map("ivr_path")
  dtmfJson     Json?     @map("dtmf_json")
  ringSeconds  Int?      @map("ring_seconds")
  talkSeconds  Int?      @map("talk_seconds")
  startedAt    DateTime? @map("started_at")
  answeredAt   DateTime? @map("answered_at")
  endedAt      DateTime? @map("ended_at")
  costPaise    BigInt?   @map("cost_paise")

  disposition     DispositionCode?
