  dispositionDueAt DateTime?       @map("disposition_due_at")

  /// Provider call SID — the idempotency key for webhooks (§23).
  providerCallSid String? @map("provider_call_sid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recording Recording?
  voicemail Voicemail?
  callback  Callback?

  @@unique([companyId, providerCallSid])
  @@index([companyId, status, createdAt])
  @@index([agentId, createdAt])
  @@index([leadId])
  @@map("calls")
}

model Recording {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @map("company_id") @db.ObjectId
  callId    String @unique @map("call_id") @db.ObjectId
  call      Call   @relation(fields: [callId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  fileKey     String  @map("file_key")
  durationSec Int?    @map("duration_sec")
  /// Retention default 12 months (§14.8); a job deletes past this date.
  retainUntil DateTime? @map("retain_until")
  /// §14.8 — TL coaching flag: GOOD | NEEDS_COACHING.
  qualityFlag String?   @map("quality_flag")
  qualityNote String?   @map("quality_note")
  playCount   Int       @default(0) @map("play_count")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("recordings")
}

model Voicemail {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @map("company_id") @db.ObjectId
  callId    String @unique @map("call_id") @db.ObjectId
  call      Call   @relation(fields: [callId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  fileKey     String  @map("file_key")
  durationSec Int?    @map("duration_sec")
  transcript  String?
  heardAt     DateTime? @map("heard_at")
  heardById   String?   @map("heard_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("voicemails")
}

/// §14.8 — a missed inbound call creates one of these. SLA 15 minutes in hours,
/// reminder at 10, escalation to TL on breach.
model Callback {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @map("company_id") @db.ObjectId
  callId    String @unique @map("call_id") @db.ObjectId
  call      Call   @relation(fields: [callId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadId    String? @map("lead_id") @db.ObjectId
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status     CallbackStatus @default(OPEN)
  slaDueAt   DateTime?      @map("sla_due_at")
  reminderAt DateTime?      @map("reminder_at")
  escalatedAt DateTime?     @map("escalated_at")
  completedAt DateTime?     @map("completed_at")
  /// Set when the customer rang back and connected before the task was worked.
  autoClosed Boolean        @default(false) @map("auto_closed")

  assigneeId String? @map("assignee_id") @db.ObjectId
  assignee   User?   @relation("CallbackAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, status, slaDueAt])
  @@map("callbacks")
}

// ===========================================================================
// 12. NOTIFICATIONS (§19)
// ===========================================================================

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String  @map("user_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  event    String
  title    String
  body     String?
  /// Route the row navigates to when clicked.
  linkPath String? @map("link_path")
  channel  NotificationChannel @default(IN_APP)
  priority Priority            @default(MEDIUM)
  readAt   DateTime?           @map("read_at")
  sentAt   DateTime?           @map("sent_at")
  /// §19 — used to suppress duplicates inside a 5-minute window.
  dedupeKey String?            @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@index([companyId, dedupeKey])
  @@map("notifications")
}

model NotificationPreference {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @map("company_id") @db.ObjectId
  userId  String @map("user_id") @db.ObjectId
  user    User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  event   String
  channel NotificationChannel
  enabled Boolean @default(true)

  @@unique([userId, event, channel])
  @@index([companyId])
  @@map("notification_preferences")
}

// ===========================================================================
// 13. SYSTEM (§17.20, §24)
// ===========================================================================

model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  actorType ActorType @default(USER) @map("actor_type")
  actorId   String?   @map("actor_id")
  action    String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  /// Before/after diff, searchable in the audit log viewer.
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Outbound webhook subscriptions — HMAC-signed POST with retry backoff (§24).
model Webhook {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  url        String
  /// ["lead.created","booking.approved","receipt.recorded"]
  eventsJson Json    @map("events_json")
  secret     String
  active     Boolean @default(true)
  lastStatus Int?    @map("last_status")
  lastAttemptAt DateTime? @map("last_attempt_at")
  failureCount  Int       @default(0) @map("failure_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([companyId, active])
  @@map("webhooks")
}

model ApiKey {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name      String
  /// Store only the hash; the plaintext key is shown once at creation.
  keyHash   String  @unique @map("key_hash")
  keyPrefix String  @map("key_prefix")
  scopesJson Json   @map("scopes_json")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("api_keys")
}

model CustomFieldDef {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  entity   CustomFieldEntity
  key      String
  label    String
  type     CustomFieldType
  required Boolean @default(false)
  optionsJson Json? @map("options_json")
  /// Roles allowed to see this field.
  visibleToRolesJson Json? @map("visible_to_roles_json")
  sortOrder Int    @default(0) @map("sort_order")
  active   Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  values CustomFieldValue[]

  @@unique([companyId, entity, key])
  @@map("custom_field_defs")
}

model CustomFieldValue {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String         @map("company_id") @db.ObjectId
  defId      String         @map("def_id") @db.ObjectId
  def        CustomFieldDef @relation(fields: [defId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Polymorphic, matching CustomFieldDef.entity.
  entityId   String         @map("entity_id")
  valueText  String?        @map("value_text")
  valueNumber Float?      @map("value_number")
  valueDate  DateTime?      @map("value_date")
  valueJson  Json?          @map("value_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([defId, entityId])
  @@index([companyId, entityId])
  @@map("custom_field_values")
}
