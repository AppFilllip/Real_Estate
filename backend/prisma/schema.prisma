  name    String
  trigger SequenceTrigger
  /// { project, temperature, tag, timeWindow }
  conditionsJson Json?   @map("conditions_json")
  active  Boolean @default(false)
  /// §13.3 — no messages 21:00–09:00 IST.
  respectQuietHours Boolean @default(true) @map("respect_quiet_hours")
