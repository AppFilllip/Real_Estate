model IvrFlowVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @map("company_id") @db.ObjectId
  flowId    String  @map("flow_id") @db.ObjectId
  flow      IvrFlow @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  version   Int
  /// The node graph: menus, ring groups, TTS, DTMF branches.
  graphJson Json    @map("graph_json")
  published Boolean @default(false)
