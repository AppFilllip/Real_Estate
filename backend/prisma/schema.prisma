/// One active enrolment per sequence per lead (§13.3).
model Enrolment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String   @map("company_id") @db.ObjectId
  sequenceId String   @map("sequence_id") @db.ObjectId
